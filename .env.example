# Copie este arquivo para .env e preencha o que for usar.
# Provedor: anthropic | openai | ollama | offline
# (se vazio, o Fin escolhe pela chave disponível; sem chave, usa "offline")
LLM_PROVIDER=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI (opcional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (modelo local, opcional) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss

# Data usada como "hoje" nos cálculos (os dados de exemplo vão até out/2025)
DATA_REFERENCIA=2025-11-01
